# ==============================================================================
# AgentDesk Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# Real .env files are strictly gitignored. NEVER commit real credentials to Git.

# ------------------------------------------------------------------------------
# 1. Outbound Email Outreach Dispatch
# ------------------------------------------------------------------------------
# Supported Modes:
#   - 'simulation': Safe offline mode. Logs and validates approval without sending real emails.
#   - 'smtp': Standard SMTP server (e.g. Gmail App Password, SendGrid, Amazon SES, Mailgun, Postmark).
#   - 'resend': Cloud HTTP email delivery via Resend API (https://resend.com).
AGENTDESK_OUTREACH_DISPATCH_MODE=simulation

# --- Option A: SMTP Configuration (Used when AGENTDESK_OUTREACH_DISPATCH_MODE=smtp) ---
AGENTDESK_SMTP_HOST=smtp.example.com
AGENTDESK_SMTP_PORT=587
AGENTDESK_SMTP_USER=your-smtp-username
AGENTDESK_SMTP_PASSWORD=your-smtp-password
AGENTDESK_SMTP_FROM_EMAIL=outreach@yourdomain.com
AGENTDESK_SMTP_FROM_NAME=AgentDesk Operator
AGENTDESK_SMTP_USE_TLS=true
AGENTDESK_SMTP_USE_SSL=false

# --- Option B: Resend API Configuration (Used when AGENTDESK_OUTREACH_DISPATCH_MODE=resend) ---
AGENTDESK_RESEND_API_KEY=re_placeholder_api_key
AGENTDESK_RESEND_FROM_EMAIL=outreach@yourdomain.com
AGENTDESK_RESEND_FROM_NAME=AgentDesk Operator

# ------------------------------------------------------------------------------
# 2. AI Outreach Drafter Provider (Optional)
# ------------------------------------------------------------------------------
# Cloud OpenAI-Compatible API Key (can also be entered in the UI per session)
AGENTDESK_LLM_API_KEY=
OPENAI_API_KEY=

# Local Ollama URL (default: http://localhost:11434/v1)
AGENTDESK_OLLAMA_BASE_URL=http://localhost:11434/v1
